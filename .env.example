# Copy to .env.local (gitignored) or set these in Vercel → Project → Settings → Environment Variables.
# Values live in Supabase → Project Settings → API. Never commit real values.

# Safe to expose to the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses RLS entirely.
# Only added in M4, only read by /app/api/cron/generate-recurring/route.ts.
# Never import this from anything under /app that renders to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
