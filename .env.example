# Copy to .env.local (gitignored) or set these in Vercel → Project → Settings → Environment Variables.
# Values live in Supabase → Project Settings → API. Never commit real values.

# Safe to expose to the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only. Never expose these to the browser. ---

# SECRET. Bypasses RLS entirely.
# Read in exactly one place: app/api/cron/generate-recurring/route.ts
# Never import this from anything under /components or /lib/supabase/client.ts.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Shared secret for the recurrence cron endpoint.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# The route FAILS CLOSED: if this is unset, it returns 401 and never runs.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
